APP_ENV=local
APP_NAME=policy-rag-backend
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres
PSYCOPG_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
DATA_GO_KR_SERVICE_KEY=change-me
OPENAI_API_KEY=change-me
# Optional. Required only when exporting the synthetic execution-control
# experiment with --langfuse. Never commit real values.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=20160
# Optional. When set, this is a per-process rerank lane capacity, not a global limit.
# RECOMMENDATION_RERANK_MAX_IN_FLIGHT=2
# Optional. Separate per-process capacity for candidate-level RAG evidence searches.
# RECOMMENDATION_EVIDENCE_MAX_IN_FLIGHT=<positive integer>
